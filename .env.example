# ── Vercel MCP Pro — configuration ───────────────────────────────────────────

# REQUIRED. Personal or team access token.
# Create at: https://vercel.com/account/settings/tokens
VERCEL_TOKEN=

# OPTIONAL. Default team scope. When set, every request is scoped to this team
# (injected as ?teamId). Find it at: Vercel → Team Settings → General → Team ID.
# Leave empty for your personal account.
VERCEL_TEAM_ID=

# OPTIONAL. Alternative to VERCEL_TEAM_ID — scope by team slug instead.
VERCEL_TEAM_SLUG=

# OPTIONAL. Safety switch. When "true", all write/delete tools are blocked
# (only reads and vercel_raw GETs run). Great for exploration/auditing.
VERCEL_READONLY=false

# OPTIONAL. Disable the vercel_raw escape hatch entirely.
VERCEL_DISABLE_RAW=false

# OPTIONAL. Tuning.
VERCEL_TIMEOUT_MS=60000
VERCEL_MAX_RETRIES=3

# ── Hosted (Streamable HTTP) deployment ─────────────────────────────────────
# Shared secret clients must send in the Authorization header to reach /api/mcp.
MCP_AUTH_TOKEN=
